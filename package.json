{
  "name": "feedsieve",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api:local": "pnpm --filter @feedsieve/community-api exec wrangler dev --config wrangler.api-local.jsonc --local --ip 127.0.0.1 --port 8787",
    "build:extension:local": "node scripts/build-local-extension.mjs",
    "keyword-packs:build": "node scripts/build-keyword-packs.mjs",
    "keyword-packs:check": "node scripts/build-keyword-packs.mjs --check",
    "keyword-packs:publish": "sh scripts/publish-keyword-packs.sh",
    "build:extension": "pnpm --filter @feedsieve/extension build",
    "verify": "sh scripts/verify.sh",
    "variant-tables:build": "node scripts/build-variant-tables.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "opencc-js": "^1.4.2",
    "playwright": "1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
